# Los scripts de shell SIEMPRE con LF, aunque se editen en Windows.
# Un CRLF en el shebang rompe la ejecución en el VPS Linux.
*.sh text eol=lf
deploy/setup-sismar.sh text eol=lf

# Binarios: nunca aplicar normalización de fin de línea (corrompería el archivo).
*.pdf binary
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.woff2 binary
*.db binary
