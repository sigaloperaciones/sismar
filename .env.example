# Copie este archivo a `.env` y complete los valores. NUNCA versione `.env`.
# (Prisma CLI y Next.js leen `.env`.)

# Secreto para firmar los JWT de sesión: valor aleatorio de MÍNIMO 32 caracteres (la app
# se niega a arrancar con menos). Recomendado: openssl rand -hex 64 (128 caracteres hex).
JWT_SECRET=cambie-este-valor-por-uno-aleatorio-largo

# URL de la base de datos PostgreSQL (valores de EJEMPLO).
DATABASE_URL="postgresql://usuario:clave@localhost:5432/sismar?schema=public"

# Hosts desde los que se acepta servir la aplicación (separados por coma).
# El middleware solo construye redirecciones hacia estos hosts (anti open-redirect).
# En desarrollo puede dejarse vacío.
ALLOWED_HOSTS=sismar.ejemplo.test

# Directorio PRIVADO donde se guardan los archivos subidos (fuera de public/).
# Si se omite, se usa <raíz>/storage/uploads. Nunca apunte a public/.
UPLOADS_DIR=./storage/uploads

# Solo para el seed inicial de una base VACÍA (opcional; si faltan, se generan
# contraseñas fuertes y se muestran una sola vez). Mínimo 8 caracteres.
# SEED_ADMIN_PASSWORD=
# SEED_MENSAJERO_PASSWORD=
# SEED_GERENCIA_PASSWORD=
# SEED_TALENTO_PASSWORD=
