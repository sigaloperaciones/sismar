# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files — contienen secretos y nunca deben commitearse.
# En el VPS, deploy/setup-sismar.sh genera `.env` con los secretos reales
# (Prisma CLI y Next.js lo leen). Solo `.env.example` se versiona.
.env
.env.local
.env.*.local
.env.docker
# .env.example sí se debe versionar (no contiene secretos reales)

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

/src/generated/prisma

# Base de datos local (nunca versionar)
*.db
*.db-journal
prisma/*.db
prisma/*.db-journal

# Logs del servidor de desarrollo
dev-server.log

# Archivos subidos por los usuarios (directorio privado, nunca versionar)
/storage/
/public/uploads/

# Archivos de bloqueo de Microsoft Office (quedan huérfanos si Word se cierra a la fuerza)
~$*
