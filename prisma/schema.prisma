generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────────────────────────────────────
// Enums (H-003 / C-013 — hallazgo B-02): la integridad del dominio vive en la BD,
// no solo en Zod. La migración convierte las columnas TEXT existentes con USING.
// ─────────────────────────────────────────────────────────────────────────────
enum Role {
  ADMIN
  MENSAJERO
  AGENCIA
}

enum TipoCorrespondencia {
  ENTRANTE
  SALIENTE
}

enum Importancia {
  NORMAL
  ALTA
}

enum EstadoCorrespondencia {
  POR_ENTREGAR
  ENTREGADA
  DEVUELTA
}

enum EstadoPlanilla {
  GENERADA
  CERRADA
  PROCESADA
}

enum TipoRecorrido {
  AM
  PM
  EXCEPCIONAL
}

enum EstadoRecorrido {
  INICIADO
  TERMINADO
  ANULADO
}

model Sede {
  id        Int       @id @default(autoincrement())
  name      String
  address   String?
  agencias  Agencia[]
}

model CentroCosto {
  id        Int       @id @default(autoincrement())
  code      String    @unique
  name      String
  agencias  Agencia[]
}

model Agencia {
  id              Int             @id @default(autoincrement())
  name            String
  sedeId          Int
  centroCostoId   Int
  email           String?
  sede            Sede            @relation(fields: [sedeId], references: [id])
  centroCosto     CentroCosto     @relation(fields: [centroCostoId], references: [id])
  usuarios        Usuario[]
  correspondenciaRecibida Correspondencia[] @relation("Destinatario")
  planillas       Planilla[]
}

model EmpresaMensajeria {
  id                  Int     @id @default(autoincrement())
  nombre              String  @unique
  activo              Boolean @default(true)
  nombreMensajero     String?
  rutasPersonalizadas Boolean @default(false)
}

model Ciudad {
  id          Int    @id @default(autoincrement())
  codigo      String @unique // 5-7 chars alfanumérico
  nombre      String
  departamento String
}

model Usuario {
  id              Int              @id @default(autoincrement())
  username        String           @unique
  email           String?
  password        String
  role            Role             @default(AGENCIA)
  agenciaId       Int?
  agencia         Agencia?         @relation(fields: [agenciaId], references: [id])
  usuarioPermisos UsuarioPermiso[]

  // H-003 / C-008 (M-08): bloqueo persistente de cuenta tras N fallos de login.
  failedLoginAttempts Int       @default(0)
  lockedUntil         DateTime?

  sesiones  Sesion[]
  auditLogs AuditLog[]
}

// H-003 / C-001 (A-05): store de sesión en BD. El JWT solo transporta `sid`;
// rol y agencia se leen de `Usuario` en cada petición. Revocable (logout,
// borrado, cambio de rol/contraseña). Expiración absoluta.
model Sesion {
  id         String    @id
  usuarioId  Int
  usuario    Usuario   @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  createdAt  DateTime  @default(now())
  expiresAt  DateTime
  revokedAt  DateTime?
  lastSeenAt DateTime  @default(now())
  ip         String?
  userAgent  String?

  @@index([usuarioId])
  @@index([expiresAt])
}

// H-003 / C-011 (M-07): bitácora append-only de operaciones (quién, qué, cuándo,
// desde dónde). La aplicación nunca actualiza ni borra filas de esta tabla.
model AuditLog {
  id        Int      @id @default(autoincrement())
  fecha     DateTime @default(now())
  usuarioId Int?
  usuario   Usuario? @relation(fields: [usuarioId], references: [id], onDelete: SetNull)
  username  String?
  accion    String
  entidad   String?
  entidadId String?
  detalle   Json?
  ip        String?

  @@index([fecha])
  @@index([usuarioId])
  @@index([entidad, entidadId])
}

model TipoAnexo {
  id      Int     @id @default(autoincrement())
  name    String  @unique
  anexos  Anexo[]
}

model Correspondencia {
  id                  Int       @id @default(autoincrement())
  consecutive         String?

  // Tipo: ENTRANTE (de externos hacia agencias) | SALIENTE (de agencias hacia externos)
  tipo                TipoCorrespondencia @default(ENTRANTE)

  fechaRecepcion      DateTime  @default(now())

  // Datos del remitente / empresa mensajería
  empresaMensajeria   String?
  remitenteNombre     String?
  remitenteCiudad     String?
  destinatarioNombre  String?

  asunto              String
  importancia         Importancia @default(NORMAL)
  necesitaRespuesta   Boolean   @default(false)

  estado              EstadoCorrespondencia @default(POR_ENTREGAR)

  // Agencia relacionada (destinataria en entrante, remitente en saliente)
  agenciaId           Int
  agencia             Agencia   @relation("Destinatario", fields: [agenciaId], references: [id])

  // Anexos
  anexos              Anexo[]

  // Documentos escaneados
  documentoRecibidoUrl String?

  // Datos de guía para correspondencia saliente
  numeroGuia          String?
  mensajero           String?
  guiaUrl             String?

  // Planilla de entrega
  planillaId          Int?
  planilla            Planilla? @relation(fields: [planillaId], references: [id])

  fechaEntrega        DateTime?
  recibidoPor         String?
  observacionDevolucion String?
  observacionAgencia    String?

  // H-003 / C-011 (M-07): autoría
  createdBy           String?
  updatedBy           String?

  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@index([estado, tipo, agenciaId])
  @@index([agenciaId])
  @@index([planillaId])
  @@index([createdAt])
}

model Anexo {
  id                Int             @id @default(autoincrement())
  correspondenciaId Int
  correspondencia   Correspondencia @relation(fields: [correspondenciaId], references: [id])
  tipoAnexoId       Int
  tipoAnexo         TipoAnexo       @relation(fields: [tipoAnexoId], references: [id])
  cantidad          Int             @default(1)
  detalles          AnexoDetalle[]
}

model AnexoDetalle {
  id            Int    @id @default(autoincrement())
  anexoId       Int
  anexo         Anexo  @relation(fields: [anexoId], references: [id], onDelete: Cascade)
  identificador String
}

model Planilla {
  id                Int       @id @default(autoincrement())
  fechaGeneracion   DateTime  @default(now())
  agenciaId         Int?
  agencia           Agencia?  @relation(fields: [agenciaId], references: [id])
  empresaMensajeria String?
  estado            EstadoPlanilla      @default(GENERADA)
  tipo              TipoCorrespondencia @default(ENTRANTE)
  documentoFirmaUrl String? // PDF o foto de la planilla saliente firmada por el mensajero

  // H-003 / C-011 (M-07): autoría
  createdBy         String?

  correspondencias Correspondencia[]
  recorridoPlanillas RecorridoPlanilla[]

  @@index([estado, tipo])
  @@index([agenciaId])
}

model Recorrido {
  id          Int      @id @default(autoincrement())
  fecha       DateTime @default(now())
  tipo        TipoRecorrido   @default(AM)
  estado      EstadoRecorrido @default(INICIADO)
  notas       String?
  creadoPor   String?

  planillas   RecorridoPlanilla[]

  // NOTA: además existe el índice único PARCIAL "Recorrido_unico_iniciado_idx"
  // (WHERE estado = 'INICIADO'), creado por la migración
  // 20261001133000_h003_recorrido_unico_activo. Prisma no lo modela: si
  // `migrate dev` propone eliminarlo por "drift", NO aceptar.
  @@index([estado])
}

model RecorridoPlanilla {
  id          Int      @id @default(autoincrement())
  recorridoId Int
  planillaId  Int
  recorrido   Recorrido @relation(fields: [recorridoId], references: [id])
  planilla    Planilla  @relation(fields: [planillaId], references: [id])

  @@unique([recorridoId, planillaId])
}

// Configuración de la empresa (branding, datos generales)
model EmpresaConfig {
  id             Int      @id @default(autoincrement())
  nombre         String   @default("SISMAR")
  nit            String?
  logoUrl        String?
  uploadsDir     String?
  // Colores en formato HSL string, ej: "221.2 83.2% 53.3%" (validado: C-010)
  colorPrimary   String?
  colorSecondary String?
  colorAccent    String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

// Catálogo de permisos disponibles en el sistema
model Permiso {
  id          Int              @id @default(autoincrement())
  codigo      String           @unique // ej: "correspondencia.entrante.crear"
  nombre      String           // "Registrar Correspondencia Entrante"
  descripcion String?
  modulo      String           // "correspondencia", "planillas", "admin"
  rolPermisos     RolPermiso[]
  usuarioPermisos UsuarioPermiso[]
}

// Permisos por defecto asignados a cada rol
model RolPermiso {
  id        Int     @id @default(autoincrement())
  rol       Role
  permisoId Int
  permiso   Permiso @relation(fields: [permisoId], references: [id])
  concedido Boolean @default(true)

  @@unique([rol, permisoId])
}

// Overrides de permisos por usuario individual
// Si no existe fila → hereda del rol
// Si existe → sobreescribe (true=grant, false=deny)
model UsuarioPermiso {
  id        Int     @id @default(autoincrement())
  usuarioId Int
  usuario   Usuario @relation(fields: [usuarioId], references: [id])
  permisoId Int
  permiso   Permiso @relation(fields: [permisoId], references: [id])
  concedido Boolean

  @@unique([usuarioId, permisoId])
}
